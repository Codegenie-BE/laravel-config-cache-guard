{
    "name": "codegenie-be/laravel-config-cache-guard",
    "description": "Prevent Laravel from using stale config or route cache after deployment changes, with Composer autoload integration and in-app auto repair for shared hosting.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/Codegenie-BE/laravel-config-cache-guard",
    "keywords": [
        "laravel",
        "laravel-config",
        "laravel-config-cache",
        "laravel-route-cache",
        "config-cache",
        "route-cache",
        "config-cache-guard",
        "stale-config",
        "stale-routes",
        "stale-cache",
        "deployment",
        "deployment-cache",
        "shared-hosting",
        "ftp-deployment",
        "artisan",
        "env",
        "php",
        "exec-disabled",
        "artisan-call",
        "codegenie",
        "auto-repair"
    ],
    "authors": [
        {
            "name": "Codegenie",
            "homepage": "https://www.codegenie.be"
        }
    ],
    "support": {
        "issues": "https://github.com/Codegenie-BE/laravel-config-cache-guard/issues",
        "source": "https://github.com/Codegenie-BE/laravel-config-cache-guard"
    },
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Codegenie\\ConfigCacheGuard\\": "src/"
        },
        "files": [
            "bootstrap/guard.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Codegenie\\ConfigCacheGuard\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Codegenie\\ConfigCacheGuard\\ConfigCacheGuardServiceProvider"
            ]
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=512M",
        "check": [
            "@check:composer",
            "@check:security",
            "@check:autoload",
            "@format:test",
            "@analyse",
            "@test"
        ],
        "check:autoload": "@composer dump-autoload --optimize --strict-psr --no-interaction",
        "check:composer": "@composer validate --strict",
        "check:security": "@composer audit --no-interaction",
        "format": "pint",
        "format:test": "pint --test",
        "test": "pest"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts-descriptions": {
        "analyse": "Run PHPStan at the configured maximum level.",
        "check": "Run every local quality gate in the same order as CI.",
        "check:autoload": "Generate an optimized autoloader and enforce strict PSR mappings.",
        "check:composer": "Validate composer.json and lock-file consistency strictly.",
        "check:security": "Audit the resolved dependency set for known security advisories.",
        "format": "Apply Laravel Pint formatting.",
        "format:test": "Check Laravel Pint formatting without changing files.",
        "test": "Run the Pest test suite."
    }
}
